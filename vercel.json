{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter @workspace/green-balance run build",
  "outputDirectory": "artifacts/green-balance/dist/public",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://green-balance-klima-wirtschaft-im-gleichgewic-rintu-cs-projects.vercel.app/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
